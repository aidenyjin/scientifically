# Database (SQLite locally; use a postgres URL + provider change in production, see README)
DATABASE_URL="file:./dev.db"

# AI content generation (server-only — never exposed to the browser)
AI_PROVIDER="anthropic"          # anthropic | openai | mock (mock = offline placeholder content, no key)
AI_MODEL=""                      # blank = adapter default (anthropic: claude-opus-5-5, openai: gpt-4.1)
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
# Optional tuning (anthropic adapter)
AI_EFFORT=""                     # low | medium | high | xhigh | max ; blank = high
AI_FALLBACKS=""                  # "off" disables server-side refusal fallbacks (default on)
AI_OUTPUT_MODE=""                # auto | structured | tool ; blank = auto (structured outputs when the schema fits)
ANTHROPIC_BASE_URL=""            # blank = official API
OPENAI_BASE_URL=""               # blank = https://api.openai.com/v1

# Admin area (/admin)
ADMIN_PASSWORD="change-me"

# Public URL used in links handed to outside AI agents (/admin/agents); blank = the request's host
APP_URL=""

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
