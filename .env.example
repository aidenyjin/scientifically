# Database (SQLite locally; use a postgres URL + provider change in production, see README)
DATABASE_URL="file:./dev.db"

# AI content generation (server-only — never exposed to the browser)
AI_PROVIDER="anthropic"          # anthropic | openai | mock
AI_MODEL=""                      # e.g. claude-sonnet-5-5 ; leave blank for the adapter default
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Admin area (/admin)
ADMIN_PASSWORD="change-me"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
